# ---- required ----
ASSISTANT_TOKEN=            # openssl rand -hex 32   (full access: your scripts / admin)
INGEST_TOKEN=               # openssl rand -hex 32   (send-input-only; put THIS on the Mac agent and phone app)
TICKETS_TOKEN=              # openssl rand -hex 32   (shared with the Ticketing app)
BIND_ADDR=127.0.0.1         # set to your server's Tailscale IP
TZ_NAME=America/Anchorage
QUIET_HOURS=22-7            # nags are held 22:00–07:00 (urgent reminders still go through)
NAG_MINUTES=15,15,30,60     # gaps between repeated nags; the last one repeats until you acknowledge

# ---- Ticketing -> Assistant webhook (optional: mirrors stage changes made in the Ticketing UI) ----
# TICKETING_WEBHOOK_SECRET=  (create a webhook in Ticketing pointing at http://assistant:8090/hooks/ticketing and paste its secret)

# ---- Canopy ----
# CANOPY_URL=https://your-canopy-host.example
# CANOPY_READ_TOKEN=spk_...      # a READ-ONLY token (used for syncing alerts)
# CANOPY_WRITE_TOKEN=spk_...     # a read/write token (used only when creating/updating tasks)
# CANOPY_GRADE_DROP_PCT=2

# ---- Google (see README "Google setup") ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=          # from: npm run google-auth
# GMAIL_ENABLED=1
# GOOGLE_SERVICE_ACCOUNT_FILE=/data/chat-service-account.json
# CHAT_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/assistant-chat
# CHAT_ALLOWED_USERS=you@your-domain.example     # ONLY these Chat users may command the assistant
# CHAT_READ_SPACES=1             # also read your own Chat spaces as input (first CHAT_ALLOWED_USERS entry must then be your users/NNN id)
# DRIVE_FOLDER_IDS=folderId1,folderId2

# ---- Files, push, misc ----
# INDEX_PATHS=/index             # container path of the mounted SMB share
# NTFY_URL=http://ntfy:80  NTFY_TOPIC=assistant   # optional phone/watch push for nags
# AUTO_APPLY_MIN_CONFIDENCE=0.6  # below this, updates/completions ask first
# CLAUDE_MODEL=                  # e.g. a cheaper/faster model for extraction
