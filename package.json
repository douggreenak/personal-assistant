{
  "name": "assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal assistant: turns speech, texts, email and chat into tasks, tickets and nagging reminders.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "google-auth": "node scripts/google-auth.ts",
    "secret": "node scripts/secret.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
